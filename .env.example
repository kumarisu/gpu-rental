###############################################################################
# GPU Rental Infra — environment template
#
#   cp .env.example .env   # then EDIT EVERY CHANGE_* VALUE
#
# Production target: Linux x86_64 host with Docker Engine + Compose v2.
# GPU templates additionally require an NVIDIA driver + nvidia-container-toolkit.
###############################################################################

# ─────────────────────────── Public URLs ─────────────────────────────────────
# What the BROWSER uses. For a real deployment replace `localhost` with the
# FQDN of the server (and put HTTPS in front, e.g. Caddy/Traefik).
KEYCLOAK_URL=http://localhost:8080
CODER_URL=http://localhost:7080
GRAFANA_URL=http://localhost:3000
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
LAGO_UI_URL=http://localhost:8580
LAGO_API_URL=http://localhost:8000

# ─────────────────────────── Internal URLs ───────────────────────────────────
# Resolvable ONLY inside the compose network — do not change unless renaming
# the compose services.
KEYCLOAK_INTERNAL=http://keycloak:8080
PROMETHEUS_INTERNAL=http://prometheus:9090
LOKI_INTERNAL=http://loki:3100
CADVISOR_INTERNAL=http://cadvisor:8080
LAGO_API_INTERNAL=http://lago-api:3000

# Linux only — GID of the host `docker` group:  getent group docker | cut -d: -f3
# The main container (Coder) and cAdvisor need it to reach /var/run/docker.sock.
DOCKER_GROUP_GID=120

# ─────────────────────────── Databases ───────────────────────────────────────
CODER_PG_PASSWORD=CHANGE_me_coder_pg
KEYCLOAK_DB_PASSWORD=CHANGE_me_keycloak_pg
LAGO_PG_PASSWORD=CHANGE_me_lago_pg
# URL-encoded version of LAGO_PG_PASSWORD for use inside DATABASE_URL
# (special characters like @ must be percent-encoded, e.g. "@" -> %40).
LAGO_PG_PASSWORD_URL=CHANGE_me_lago_pg


# ─────────────────────────── Keycloak (SSO) ──────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_me_keycloak_admin
CODER_OIDC_CLIENT_SECRET=CHANGE_me_coder_oidc_secret
GRAFANA_OIDC_CLIENT_SECRET=CHANGE_me_grafana_oidc_secret

# Demo users created by `make keycloak-init` (username / email / password)
KEYCLOAK_DEMO_MIKE_PASSWORD=CHANGE_me_mike
KEYCLOAK_DEMO_ANNA_PASSWORD=CHANGE_me_anna

# ─────────────────────────── Grafana ─────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=CHANGE_me_grafana_admin

# ─────────────────────────── Lago (billing) ──────────────────────────────────
# LAGO_CREATE_ORG=true makes Lago auto-create the organisation on first boot
# using the values below (including the organisation API key LAGO_ORG_API_KEY).
# Fallback: sign up in the UI at ${LAGO_UI_URL} and paste the key from
# Developer → API keys into LAGO_ORG_API_KEY.
LAGO_CREATE_ORG=true
LAGO_ORG_NAME=GPU Rental
LAGO_ORG_USER_EMAIL=admin@gpu.local
LAGO_ORG_USER_PASSWORD=CHANGE_me_lago_admin
LAGO_ORG_API_KEY=gpu-rental-org-key-CHANGE_ME

# Required Lago secrets (see https://getlago.com/docs/guide/02_self-hosting)
LAGO_SECRET_KEY_BASE=CHANGE_ME_64_HEX                     # openssl rand -hex 64
LAGO_RSA_PRIVATE_KEY=CHANGE_ME                             # openssl genrsa 2048 | base64
LAGO_ENCRYPTION_PRIMARY_KEY=CHANGE_ME_32_CHARS
LAGO_ENCRYPTION_DETERMINISTIC_KEY=CHANGE_ME_32_CHARS
LAGO_ENCRYPTION_KEY_DERIVATION_SALT=CHANGE_ME_32_CHARS

# Billing plan & demo customers (created by `make lago-bootstrap`)
LAGO_PLAN_CODE=gpu-usage
LAGO_PLAN_NAME=GPU Usage
LAGO_DEMO_USERS=mike,anna
LAGO_EMAIL_DOMAIN=gpu.local

# ─────────────────────────── billing-sync ────────────────────────────────────
# How often Prometheus deltas are pushed to Lago as metered events (seconds).
SYNC_INTERVAL_SECONDS=60
# Ignore deltas below this threshold (avoids noise events).
SYNC_MIN_DELTA=0.000001

# ─────────────────────────── GPU exporter (optional) ─────────────────────────
# Port the host-side GPU exporter listens on (see monitoring/gpu/README.md)
GPU_EXPORTER_PORT=9091