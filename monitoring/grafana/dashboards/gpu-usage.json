{
  "dashboard": {
    "schemaVersion": 39,
    "title": "GPU Rental — Usage per user",
    "tags": [
      "gpu-rental"
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "description": "Usage of Coder workspace containers, attributed per user via the coder.owner label exposed by cAdvisor. Logs come from Loki (docker json-file, tag={{.Name}}).",
    "panels": [
      {
        "id": 1,
        "type": "timeseries",
        "title": "CPU used (cores) — per user",
        "datasource": {
          "type": "prometheus",
          "uid": "<UID_PROMETHEUS>"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "<UID_PROMETHEUS>"
            },
            "expr": "sum by (container_label_coder_owner) (rate(container_cpu_usage_seconds_total{container_label_coder_owner!=\"\"}[5m]))",
            "legendFormat": "{{container_label_coder_owner}}",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "description": "Rate of per-container CPU-seconds, summed per coder owner."
      },
      {
        "id": 2,
        "type": "timeseries",
        "title": "Memory used (GiB) — per user",
        "datasource": {
          "type": "prometheus",
          "uid": "<UID_PROMETHEUS>"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "<UID_PROMETHEUS>"
            },
            "expr": "sum by (container_label_coder_owner) (container_memory_usage_bytes{container_label_coder_owner!=\"\"}) / 1073741824",
            "legendFormat": "{{container_label_coder_owner}}",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "gibibytes"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 3,
        "type": "timeseries",
        "title": "Network in (KiB/s) — per user",
        "datasource": {
          "type": "prometheus",
          "uid": "<UID_PROMETHEUS>"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "<UID_PROMETHEUS>"
            },
            "expr": "sum by (container_label_coder_owner) (rate(container_network_receive_bytes_total{container_label_coder_owner!=\"\"}[5m])) / 1024",
            "legendFormat": "{{container_label_coder_owner}}",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "KBs"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        }
      },
      {
        "id": 4,
        "type": "timeseries",
        "title": "Network out (KiB/s) — per user",
        "datasource": {
          "type": "prometheus",
          "uid": "<UID_PROMETHEUS>"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "<UID_PROMETHEUS>"
            },
            "expr": "sum by (container_label_coder_owner) (rate(container_network_transmit_bytes_total{container_label_coder_owner!=\"\"}[5m])) / 1024",
            "legendFormat": "{{container_label_coder_owner}}",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "KBs"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        }
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "GPU utilization % (host GPUs) — optional exporter",
        "datasource": {
          "type": "prometheus",
          "uid": "<UID_PROMETHEUS>"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "<UID_PROMETHEUS>"
            },
            "expr": "gpu_utilization_percent{gpu=~\".*\"}",
            "legendFormat": "gpu {{gpu}}",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 16
        },
        "description": "Only populated on Linux hosts running the GPU exporter. Empty on macOS is expected."
      },
      {
        "id": 6,
        "type": "timeseries",
        "title": "Disk write (KiB/s) — per user",
        "datasource": {
          "type": "prometheus",
          "uid": "<UID_PROMETHEUS>"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "<UID_PROMETHEUS>"
            },
            "expr": "sum by (container_label_coder_owner) (rate(container_fs_writes_bytes_total{container_label_coder_owner!=\"\"}[5m])) / 1024",
            "legendFormat": "{{container_label_coder_owner}}",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "KBs"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 24
        }
      },
      {
        "id": 7,
        "type": "logs",
        "title": "Workspace logs (docker containers)",
        "description": "All docker logs via Loki. Filter per workspace e.g. {container_name=\"coder-mike-kuma\"}.",
        "datasource": {
          "type": "loki",
          "uid": "<UID_LOKI>"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "<UID_LOKI>"
            },
            "expr": "{container_name=~\".+\"}",
            "queryType": "range"
          }
        ],
        "options": {
          "showTime": true,
          "sortOrder": "Descending",
          "wrapLogMessage": false
        },
        "gridPos": {
          "h": 12,
          "w": 24,
          "x": 0,
          "y": 32
        }
      },
      {
        "id": 8,
        "type": "text",
        "title": "Package catalog (static reference)",
        "description": "Must match PACKAGES in billing/sync/sync.py and billing/lago/bootstrap.py",
        "datasource": {
          "type": "datasource",
          "uid": "-- Mixed --"
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 44
        },
        "options": {
          "mode": "markdown",
          "content": "| package_code | display_name | price_cents | price_usd |\n|---|---|---|---|\n| basic-cpu-2-ram-8 | Basic CPU (2 cores / 8GB RAM) | 500 | $5.00 |\n| pro-cpu-8-ram-32 | Pro CPU (8 cores / 32GB RAM) | 2000 | $20.00 |\n| gpu-cuda-1-ram-32 | GPU CUDA (1 GPU / 32GB RAM) | 5000 | $50.00 |"
        },
        "fieldConfig": {
          "defaults": {},
          "overrides": []
        }
      },
      {
        "id": 9,
        "type": "timeseries",
        "title": "Active workspaces per package (live, from cAdvisor labels)",
        "description": "Counts running Coder containers grouped by cAdvisor label container_label_gpu_rental_package (Docker label gpu_rental_package from Coder templates). billing-sync uses this same label as source 1 for package_code.",
        "datasource": {
          "type": "prometheus",
          "uid": "<UID_PROMETHEUS>"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "<UID_PROMETHEUS>"
            },
            "expr": "count by (container_label_gpu_rental_package) (container_cpu_usage_seconds_total{container_label_coder_owner!=\"\"})",
            "legendFormat": "{{container_label_gpu_rental_package}}",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 44
        }
      },
      {
        "id": 10,
        "type": "timeseries",
        "title": "Active workspaces detail (owner x package x container)",
        "description": "Same source as sync metric snapshot, broken down to debug owner/package attribution.",
        "datasource": {
          "type": "prometheus",
          "uid": "<UID_PROMETHEUS>"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "<UID_PROMETHEUS>"
            },
            "expr": "sum by (container_label_coder_owner, container_label_gpu_rental_package, name) (container_cpu_usage_seconds_total{container_label_coder_owner!=\"\"})",
            "legendFormat": "{{container_label_coder_owner}} / {{container_label_gpu_rental_package}} / {{name}}",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 52
        }
      }
    ],
    "timezone": "browser"
  },
  "overwrite": true,
  "version": 0
}
