{
  "dashboard": {
    "schemaVersion": 39,
    "title": "GPU Rental — Usage per user",
    "tags": [
      "gpu-rental"
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "description": "Usage of Coder workspace containers, attributed per user via the coder.owner label exposed by cAdvisor. Logs come from Loki (docker json-file, tag={{.Name}}).",
    "panels": [
      {
        "id": 1,
        "type": "timeseries",
        "title": "CPU used (cores) — per user",
        "datasource": {
          "type": "prometheus",
          "uid": "__DS_PROMETHEUS__"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "__DS_PROMETHEUS__"
            },
            "expr": "sum by (container_label_coder_owner) (rate(container_cpu_usage_seconds_total{container_label_coder_owner!=\"\"}[5m]))",
            "legendFormat": "{{container_label_coder_owner}}",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "description": "Rate of per-container CPU-seconds, summed per coder owner."
      },
      {
        "id": 2,
        "type": "timeseries",
        "title": "Memory used (GiB) — per user",
        "datasource": {
          "type": "prometheus",
          "uid": "__DS_PROMETHEUS__"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "__DS_PROMETHEUS__"
            },
            "expr": "sum by (container_label_coder_owner) (container_memory_usage_bytes{container_label_coder_owner!=\"\"}) / 1073741824",
            "legendFormat": "{{container_label_coder_owner}}",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "gibibytes"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 3,
        "type": "timeseries",
        "title": "Network in (KiB/s) — per user",
        "datasource": {
          "type": "prometheus",
          "uid": "__DS_PROMETHEUS__"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "__DS_PROMETHEUS__"
            },
            "expr": "sum by (container_label_coder_owner) (rate(container_network_receive_bytes_total{container_label_coder_owner!=\"\"}[5m])) / 1024",
            "legendFormat": "{{container_label_coder_owner}}",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "KBs"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        }
      },
      {
        "id": 4,
        "type": "timeseries",
        "title": "Network out (KiB/s) — per user",
        "datasource": {
          "type": "prometheus",
          "uid": "__DS_PROMETHEUS__"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "__DS_PROMETHEUS__"
            },
            "expr": "sum by (container_label_coder_owner) (rate(container_network_transmit_bytes_total{container_label_coder_owner!=\"\"}[5m])) / 1024",
            "legendFormat": "{{container_label_coder_owner}}",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "KBs"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        }
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "GPU utilization % (host GPUs) — optional exporter",
        "datasource": {
          "type": "prometheus",
          "uid": "__DS_PROMETHEUS__"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "__DS_PROMETHEUS__"
            },
            "expr": "gpu_utilization_percent{gpu=~\".*\"}",
            "legendFormat": "gpu {{gpu}}",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 16
        },
        "description": "Only populated on Linux hosts running the GPU exporter. Empty on macOS is expected."
      },
      {
        "id": 6,
        "type": "timeseries",
        "title": "Disk write (KiB/s) — per user",
        "datasource": {
          "type": "prometheus",
          "uid": "__DS_PROMETHEUS__"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "__DS_PROMETHEUS__"
            },
            "expr": "sum by (container_label_coder_owner) (rate(container_fs_writes_bytes_total{container_label_coder_owner!=\"\"}[5m])) / 1024",
            "legendFormat": "{{container_label_coder_owner}}",
            "range": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "KBs"
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 24
        }
      },
      {
        "id": 7,
        "type": "logs",
        "title": "Workspace logs (docker containers)",
        "description": "All docker logs via Loki. Filter per workspace e.g. {container_name=\"coder-mike-kuma\"}.",
        "datasource": {
          "type": "loki",
          "uid": "__DS_LOKI__"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "__DS_LOKI__"
            },
            "expr": "{container_name=~\".+\"}",
            "queryType": "range"
          }
        ],
        "options": {
          "showTime": true,
          "sortOrder": "Descending",
          "wrapLogMessage": false
        },
        "gridPos": {
          "h": 12,
          "w": 24,
          "x": 0,
          "y": 32
        }
      }
    ],
    "timezone": "browser"
  },
  "overwrite": true,
  "version": 0
}